# Copy to .env.local for local dev, and set the same values as
# repository variables (Settings -> Secrets and variables -> Actions -> Variables)
# so the GitHub Actions build picks them up.

# WhatsApp business number, country code first, digits only. No + and no spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Google Apps Script web app URL (added in step 4). Leave blank until then.
NEXT_PUBLIC_APPS_SCRIPT_URL=

# ONLY set this if hosting at username.github.io/<repo>. Leave EMPTY for a custom domain.
NEXT_PUBLIC_BASE_PATH=
